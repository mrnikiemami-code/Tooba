# Build
bin/
obj/
*.user
*.suo

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# Secrets
.env
.env.local
.env.*.local
appsettings.*.local.json

# ASP.NET Data Protection key ring is runtime material: persisting it in source leaks the master key.
# The ring is created at runtime under the Host content root (Tooba.Shipping.Infrastructure,
# App_Data/dataprotection-keys) and must never be committed.
src/backend/Host/Tooba.Host/App_Data/dataprotection-keys/
**/App_Data/dataprotection-keys/

# TB-279-R2 containment: task scratch/probe/seed scripts that were committed by accident.
# They stay on the author's disk and are not source. Narrow, name-scoped rules only: legitimate
# product scripts (scripts/capture-*, scripts/prove-*, scripts/dev/*) remain tracked.
/scripts/tb266r1-*.mjs
/scripts/tb270r2-*.mjs
/scripts/tb276-read-bridge-db.mjs
/scripts/tb277r1-post-result.mjs
/scripts/tb278-post-result.mjs
/scripts/tb279-post-result.mjs
/scripts/tb279-read-bridge-db.mjs

# OS
Thumbs.db
.DS_Store

# External references — not product source
shopeiva/
help.pdf

# Host/runtime logs
src/backend/Host/Tooba.Host/*.log
src/backend/Host/Tooba.Host/**/*.log
src/backend/Host/Tooba.Host/*.err.log
src/backend/Host/Tooba.Host/**/*.err.log
src/frontend/next-dev*.log
src/frontend/next-dev*.err.log

# Local agent/test/build artifacts (repo-root dumps only; not product source)
.tmp*/
.tmp-*

# Local Cursor bridge database
cursor-chat-bridge.db
cursor-chat-bridge.db-*

# Local Visual Studio metadata
src/backend/.vs/

# Transient bridge task transport metadata (not durable recovery evidence)
docs/ai/tasks/.claim.json
docs/ai/tasks/.task.md
docs/ai/tasks/_bridge-*.json
docs/ai/tasks/_wake-*
docs/ai/tasks/*.bridge-meta.json
docs/ai/tasks/*.claim.json
docs/ai/tasks/*.task.raw.json
docs/ai/tasks/*bridge-raw*.json
docs/ai/tasks/*_next.json

# Transient evidence diagnostics (untracked only; tracked files stay tracked)
docs/evidence/**/screenshots/**/failures/**
docs/evidence/**/*-runtime-console*.log
docs/evidence/**/*.log
docs/evidence/**/*-raw.json
docs/evidence/**/_*.mjs
docs/evidence/**/*.ps1
docs/evidence/**/*fail*.png
docs/evidence/**/capture-error.png
docs/evidence/**/r*-console-probe.mjs
docs/evidence/**/r*-console-stack.mjs
docs/evidence/GIT-DOCS-TRIAGE/

docs/evidence/**/RESULT.bridge.txt
/docs/evidence/TB-TMAR-CART-ARCH-COMPLETE-002-REVERIFY-001-R1/post-result.js

# Test crash/hang dumps (never track binary dumps or TestResults)
src/**/TestResults/
*.dmp

# Raw host stdout captures: unbounded, can exceed GitHub's 100 MB blob limit.
# Only already-tracked (small) captures stay tracked; new/grown ones are ignored.
docs/architecture/evidence/**/host-stdout*.txt
