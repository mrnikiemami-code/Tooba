<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tooba.Shipping.Tests</RootNamespace>
    <AssemblyName>Tooba.Shipping.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tooba.Shipping.Contracts\Tooba.Shipping.Contracts.csproj" />
    <ProjectReference Include="..\Tooba.Shipping.Domain\Tooba.Shipping.Domain.csproj" />
    <ProjectReference Include="..\Tooba.Shipping.Application\Tooba.Shipping.Application.csproj" />
    <ProjectReference Include="..\Tooba.Shipping.Infrastructure\Tooba.Shipping.Infrastructure.csproj" />
    <!-- Focused W1 tests exercise the module's own HTTP-owned authorizer/presentation seams. -->
    <ProjectReference Include="..\Tooba.Shipping.Endpoints\Tooba.Shipping.Endpoints.csproj" />
    <!-- Compatibility proof only: the test asserts that Shipping can express a policy for every code the
         existing Fulfillment catalog already publishes, WITHOUT duplicating those catalog rows. No
         production project in this module references Fulfillment. -->
    <ProjectReference Include="..\..\Fulfillment\Tooba.Fulfillment.Contracts\Tooba.Fulfillment.Contracts.csproj" />
    <!-- Destination identity for the quote request (Contracts-to-Contracts, same as the module itself). -->
    <ProjectReference Include="..\..\Geography\Tooba.Geography.Contracts\Tooba.Geography.Contracts.csproj" />
    <!-- INTEGRATION-TEST-ONLY composition proof (TB-201-R2): the Shipping authoring read bridge must be
         proven against the REAL Geography EF reader and the REAL module composition roots, which cannot be
         reached through Contracts alone. Production projects keep Contracts-only references; no production
         project in either module references the other's Infrastructure. -->
    <ProjectReference Include="..\..\Geography\Tooba.Geography.Infrastructure\Tooba.Geography.Infrastructure.csproj" />
    <!-- TB-188: the authoring-context read proves its real Contracts seams (Localization language
         lookup, StoreContext default currency) with controlled fakes; no foreign implementation. -->
    <ProjectReference Include="..\..\Localization\Tooba.Localization.Contracts\Tooba.Localization.Contracts.csproj" />
    <ProjectReference Include="..\..\StoreContext\Tooba.StoreContext.Contracts\Tooba.StoreContext.Contracts.csproj" />
  </ItemGroup>
</Project>
