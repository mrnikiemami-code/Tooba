{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tooba": {
    "Edition": "Unset",
    "DeploymentId": "",
    "TrustedProxies": [],
    "Marketplace": {
      "ConnectionReference": ""
    },
    "SingleStore": {
      "Tenants": []
    },
    "PostgreSQL": {
      "ConnectionString": "",
      "ConnectionReferences": {}
    },
    "Messaging": {
      "Enabled": false,
      "ConnectionReference": "",
      "Schema": "transport",
      "UseInProcessTestDouble": false
    },
    "Outbox": {
      "Enabled": true,
      "PollIntervalSeconds": 2,
      "BatchSize": 20,
      "RetryBaseDelaySeconds": 2,
      "MaxAttempts": 5,
      "LockSeconds": 30
    },
    "Observability": {
      "ServiceName": "Tooba.Host",
      "OtlpEndpoint": "",
      "EnableTracing": true,
      "EnableMetrics": true
    },
    "Cache": {
      "Provider": "None"
    },
    "ExternalProviders": {}
  }
}
