{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tooba": {
    "Edition": "Unset",
    "DeploymentId": "",
    "TrustedProxies": [],
    "Marketplace": {
      "ConnectionReference": ""
    },
    "SingleStore": {
      "Tenants": []
    },
    "PostgreSQL": {
      "ConnectionString": "",
      "ConnectionReferences": {}
    },
    "Messaging": {
      "Enabled": false,
      "Transport": "PostgreSql",
      "ConnectionReference": "",
      "Schema": "transport",
      "UseInProcessTestDouble": false
    },
    "Outbox": {
      "Enabled": true,
      "PollIntervalSeconds": 2,
      "BatchSize": 20,
      "RetryBaseDelaySeconds": 2,
      "MaxAttempts": 5,
      "LockSeconds": 30
    },
    "CartExpiry": {
      "Enabled": true,
      "PollIntervalSeconds": 5,
      "BatchSize": 20
    },
    "PaymentReconciliation": {
      "Enabled": true,
      "PollIntervalSeconds": 60,
      "PendingAgeMinutes": 5,
      "BatchSize": 20
    },
    "Observability": {
      "ServiceName": "Tooba.Host",
      "OtlpEndpoint": "",
      "EnableTracing": true,
      "EnableMetrics": true
    },
    "Cache": {
      "Enabled": true,
      "Provider": "Memory",
      "EntryCountLimit": 10000,
      "StampedeProtection": true
    },
    "Authorization": {
      "Mode": "Disabled",
      "ApplySchemaOnStartup": false,
      "SpiceDb": {
        "Endpoint": "",
        "Token": "",
        "UseTls": true,
        "TimeoutSeconds": 5,
        "RetryMaxAttempts": 3,
        "RetryBaseDelayMilliseconds": 100,
        "ConsistencyMode": "FullyConsistent",
        "ReadinessProbeEnabled": true
      }
    },
    "AuthSecurity": {
      "CorsAllowedOrigins": [],
      "EnableSecurityHeaders": true,
      "EnableHsts": true,
      "EnableCspReportOnly": true,
      "AuthRateLimitPermitLimit": 30,
      "AuthRateLimitWindowSeconds": 60,
      "MaxRequestBodyBytes": 10485760
    },
    "ExternalProviders": {}
  },
  "Identity": {
    "PasswordPolicy": {
      "MinimumLength": 10,
      "RequireLetterAndDigit": false
    },
    "Lifecycle": {
      "SessionLifetimeHours": 336,
      "ChallengeLifetimeMinutes": 15,
      "MaxChallengeAttempts": 5
    },
    "OtpDelivery": {
      "Mode": "Capturing",
      "WebhookUrl": "",
      "WebhookApiKey": "",
      "TimeoutSeconds": 10
    }
  },
  "Payment": {
    "Gateway": {
      "Mode": "Sandbox",
      "DefaultProvider": "fake",
      "WebhookSigningSecret": "",
      "StatusQueryBaseUrl": "",
      "StatusQueryApiKey": "",
      "TimeoutSeconds": 15
    }
  }
}
