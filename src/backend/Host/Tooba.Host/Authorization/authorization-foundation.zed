// Versioned SpiceDB foundation schema (v3). Source of truth mirrors FoundationAuthorizationSchemaProvider.
// Apply via ops process or ApplySchemaOnStartup in controlled environments only.
// Note: object type must NOT be named `permission` (SpiceDB keyword).

definition user {}

definition tenant {
  relation member: user
  permission view = member
}

definition party {
  relation member: user
  permission view = member
}

definition role {
  relation member: user
}

definition capability {
  relation granted: user | role#member
  permission allow = granted
}

definition category {
  relation handler: user | role#member
  permission handle_orders = handler
}
