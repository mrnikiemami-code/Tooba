{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tooba": {
    "Edition": "SingleStore",
    "DeploymentId": "",
    "TrustedProxies": [],
    "Marketplace": {
      "ConnectionReference": ""
    },
    "SingleStore": {
      "Tenants": []
    },
    "PostgreSQL": {
      "ConnectionString": "",
      "ConnectionReferences": {}
    },
    "Messaging": {
      "Enabled": false,
      "Transport": "PostgreSql",
      "ConnectionReference": "",
      "Schema": "transport",
      "UseInProcessTestDouble": false
    },
    "Outbox": {
      "Enabled": true,
      "PollIntervalSeconds": 2,
      "BatchSize": 20,
      "RetryBaseDelaySeconds": 2,
      "MaxAttempts": 5,
      "LockSeconds": 30
    },
    "Observability": {
      "ServiceName": "Tooba.Host",
      "OtlpEndpoint": "",
      "EnableTracing": true,
      "EnableMetrics": true
    },
    "Cache": {
      "Enabled": true,
      "Provider": "Memory",
      "EntryCountLimit": 10000,
      "StampedeProtection": true
    },
    "Authorization": {
      "Mode": "SpiceDb",
      "ApplySchemaOnStartup": false,
      "SpiceDb": {
        "Endpoint": "",
        "Token": "",
        "UseTls": true,
        "TimeoutSeconds": 5
      }
    },
    "ExternalProviders": {}
  },
  "Identity": {
    "PasswordPolicy": {
      "MinimumLength": 10,
      "RequireLetterAndDigit": true
    },
    "Lifecycle": {
      "SessionLifetimeHours": 336,
      "ChallengeLifetimeMinutes": 15,
      "MaxChallengeAttempts": 5
    }
  }
}
