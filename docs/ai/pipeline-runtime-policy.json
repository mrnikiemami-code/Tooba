{
  "pipelineProtocol": "BRIDGE-V2",
  "projectPrefix": "TOOBA",
  "channelId": "tooba-main",
  "workerRole": "Coding Agent Worker",
  "taskSource": "bridge-dispatched-downloadable-task-md",
  "resultDestination": "bridge",
  "workerStatusWhileIdle": "Waiting",
  "workerStatusWhileActive": "Working",
  "heartbeatIntervalSeconds": 5,
  "pollEndpoint": "/api/tasks/next?channelId=tooba-main",
  "oneWorkerOneActiveTask": true,
  "pollingStoppedWhileWorking": true,
  "workingHeartbeatContinues": true,
  "workerPassIsArchitectAccept": false,
  "systemBridgeAlertIsResult": false,
  "historicalChatExecutable": false,
  "historicalTaskArchiveExecutable": false,
  "repositoryIsSourceOfTruth": true,
  "automaticContinuationRequiresArchitectReview": true,
  "architectDecisions": [
    "ACCEPT",
    "REPAIR",
    "BLOCK"
  ],
  "mainBranch": "main",
  "requireLocalCommit": true,
  "requireRemotePush": true,
  "requireHeadEqualsOriginMain": true,
  "stopOnlyWhen": [
    "architectural_choice_genuinely_required",
    "source_of_truth_conflict",
    "unsafe_or_unresolved_repository_state",
    "material_data_loss_risk",
    "security_critical_ambiguity",
    "missing_external_business_fact",
    "user_pause"
  ]
}