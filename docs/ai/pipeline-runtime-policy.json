{
  "protocol": "BRIDGE-WAKE-V1",
  "channelId": "tooba-main",
  "bridgeBaseUrl": "http://127.0.0.1:17321",
  "healthEndpoint": "/health",
  "taskClaimEndpoint": "/api/tasks/next?channelId=tooba-main",
  "resultEndpoint": "/api/results",
  "workerId": "tooba-worker-01",
  "workerStatusWhileIdle": "Idle",
  "workerStatusWhileWorking": "Working",
  "wakeControlMessage": "BRIDGE-WAKE",
  "watchdog": {
    "enabled": true,
    "observePendingTasks": true,
    "wakeOncePerPendingTask": true,
    "mustNotCreateTasks": true,
    "mustNotModifyScope": true,
    "mustNotReviewResults": true
  },
  "idleSemantics": {
    "continuousPollingRequired": false,
    "idleHeartbeatRequired": false,
    "permanentlyOnlineWorkerRequired": false,
    "offlineBetweenTasksIsNormal": true
  },
  "retiredBridgeV2Semantics": {
    "continuousPollingWhileIdle": "RETIRED",
    "idleHeartbeatWhileWaiting": "RETIRED",
    "workerWaitingLoop": "RETIRED",
    "alertOnWorkerOfflineBetweenTasks": "RETIRED"
  },
  "oneWorkerOneActiveTask": true,
  "workerPassNotArchitectAccept": true,
  "systemBridgeAlertIsNotResult": true,
  "taskArtifactExtension": ".task.md",
  "persistReceivedTaskArtifactUnder": "docs/ai/tasks/",
  "notes": "Worker remains IDLE between Tasks. External Watchdog sends BRIDGE-WAKE when a Pending Task appears. BRIDGE-WAKE is control traffic, not Task/Result."
}
